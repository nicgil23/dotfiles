{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/nvim/anime_header.txt",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": " ➜ "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "󰀉  {user-name-colored}@{host-name-colored}"
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 OS      ",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel  ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU     ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "󰨇 WM/DE   ",
            "keyColor": "magenta"
        },

        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "cyan",
            "format": "{} (pacman)"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime  ",
            "keyColor": "green",
            "format": "{2}h {3}m"
        },
        {
            "type": "command",
            "key": "󰥔 OS Age  ",
            "keyColor": "yellow",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory  ",
            "keyColor": "red"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
